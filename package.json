{
  "name": "gerrit-workbench",
  "displayName": "Gerrit Workbench",
  "description": "%extension.description%",
  "version": "0.16.0",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:gerrit.dashboard",
    "onFileSystem:gerrit",
    "onView:gerrit.changedFiles"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/api.js && node --check src/git.js && node --check media/main.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gerritWorkbench",
          "title": "Gerrit Workbench",
          "icon": "media/gerrit.svg"
        }
      ],
      "panel": [
        {
          "id": "gerritChanges",
          "title": "%extension.contributes.viewsContainers.panel.0.title%",
          "icon": "media/gerrit.svg"
        }
      ]
    },
    "views": {
      "gerritWorkbench": [
        {
          "type": "webview",
          "id": "gerrit.dashboard",
          "name": "%extension.contributes.views.gerritWorkbench.0.name%"
        }
      ],
      "gerritChanges": [
        {
          "type": "webview",
          "id": "gerrit.changedFiles",
          "name": "%extension.contributes.views.gerritChanges.0.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "gerrit.refresh",
        "title": "%extension.contributes.commands.0.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "gerrit.connect",
        "title": "%extension.contributes.commands.1.title%",
        "icon": "$(plug)"
      },
      {
        "command": "gerrit.push",
        "title": "%extension.contributes.commands.2.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gerrit.comment",
        "title": "%extension.contributes.commands.3.title%",
        "icon": "$(comment)"
      },
      {
        "command": "gerrit.reply",
        "title": "%extension.contributes.commands.4.title%",
        "icon": "$(send)"
      },
      {
        "command": "gerrit.discussion",
        "title": "%extension.contributes.commands.5.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gerrit.settings",
        "title": "%extension.contributes.commands.6.title%",
        "icon": "$(gear)"
      },
      {
        "command": "gerrit.logs",
        "title": "%extension.contributes.commands.7.title%",
        "icon": "$(output)"
      },
      {
        "command": "gerrit.previousComment",
        "title": "%extension.contributes.commands.8.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gerrit.nextComment",
        "title": "%extension.contributes.commands.9.title%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gerrit.fileComments",
        "title": "%extension.contributes.commands.10.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "gerrit.showFiles",
        "title": "%extension.contributes.commands.11.title%",
        "icon": "$(files)"
      },
      {
        "command": "gerrit.tasks",
        "title": "%extension.contributes.commands.12.title%",
        "icon": "$(tasklist)"
      },
      {
        "command": "gerrit.openLeftFile",
        "title": "%extension.contributes.commands.13.title%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gerrit.openRightFile",
        "title": "%extension.contributes.commands.14.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gerrit.openThisFile",
        "title": "%extension.contributes.commands.15.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gerrit.postCommentZh",
        "title": "发布评论",
        "icon": "$(send)"
      },
      {
        "command": "gerrit.postCommentEn",
        "title": "Post comment",
        "icon": "$(send)"
      },
      {
        "command": "gerrit.replyZh",
        "title": "回复",
        "icon": "$(send)"
      },
      {
        "command": "gerrit.replyEn",
        "title": "Reply",
        "icon": "$(send)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gerrit.refresh",
          "when": "view == gerrit.dashboard",
          "group": "navigation"
        },
        {
          "command": "gerrit.connect",
          "when": "view == gerrit.dashboard",
          "group": "navigation"
        },
        {
          "command": "gerrit.settings",
          "when": "view == gerrit.dashboard",
          "group": "navigation"
        },
        {
          "command": "gerrit.logs",
          "when": "view == gerrit.dashboard",
          "group": "navigation"
        },
        {
          "command": "gerrit.refresh",
          "when": "view == gerrit.changedFiles",
          "group": "navigation"
        },
        {
          "command": "gerrit.tasks",
          "when": "view == gerrit.dashboard || view == gerrit.changedFiles",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "gerrit.push",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gerrit.comment",
          "when": "resourceScheme == gerrit",
          "group": "gerrit"
        }
      ],
      "editor/title": [
        {
          "command": "gerrit.comment",
          "when": "resourceScheme == gerrit",
          "group": "navigation"
        },
        {
          "command": "gerrit.previousComment",
          "when": "resourceScheme == gerrit",
          "group": "navigation"
        },
        {
          "command": "gerrit.nextComment",
          "when": "resourceScheme == gerrit",
          "group": "navigation"
        },
        {
          "command": "gerrit.fileComments",
          "when": "resourceScheme == gerrit",
          "group": "navigation"
        },
        {
          "command": "gerrit.openLeftFile",
          "when": "resourceScheme == gerrit && activeEditor == workbench.editors.textDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "gerrit.openRightFile",
          "when": "resourceScheme == gerrit && activeEditor == workbench.editors.textDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "gerrit.openThisFile",
          "when": "resourceScheme == gerrit && activeEditor == workbench.editors.textDiffEditor",
          "group": "navigation@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "gerrit.postCommentZh",
          "when": "commentController == gerrit && gerritCommentLanguage == zh && commentThread != gerritReply",
          "group": "inline"
        },
        {
          "command": "gerrit.postCommentEn",
          "when": "commentController == gerrit && gerritCommentLanguage == en && commentThread != gerritReply",
          "group": "inline"
        },
        {
          "command": "gerrit.replyZh",
          "when": "commentController == gerrit && gerritCommentLanguage == zh && commentThread == gerritReply",
          "group": "inline"
        },
        {
          "command": "gerrit.replyEn",
          "when": "commentController == gerrit && gerritCommentLanguage == en && commentThread == gerritReply",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "gerrit.postCommentZh",
          "when": "false"
        },
        {
          "command": "gerrit.postCommentEn",
          "when": "false"
        },
        {
          "command": "gerrit.replyZh",
          "when": "false"
        },
        {
          "command": "gerrit.replyEn",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Gerrit Workbench",
      "properties": {
        "gerrit.defaultQuery": {
          "type": "string",
          "default": "is:open",
          "description": "%extension.contributes.configuration.properties.gerrit.defaultQuery.description%"
        },
        "gerrit.pageSize": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 100,
          "description": "%extension.contributes.configuration.properties.gerrit.pageSize.description%"
        },
        "gerrit.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 3000,
          "maximum": 120000,
          "description": "%extension.contributes.configuration.properties.gerrit.requestTimeout.description%"
        },
        "gerrit.comments.expandThreads": {
          "type": "boolean",
          "default": true,
          "description": "%extension.contributes.configuration.properties.gerrit.comments.expandThreads.description%"
        },
        "gerrit.diff.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "%extension.contributes.configuration.properties.gerrit.diff.openBeside.description%"
        },
        "gerrit.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "%extension.contributes.configuration.properties.gerrit.logLevel.description%"
        },
        "gerrit.commitInfo.defaultExpanded": {
          "type": "boolean",
          "default": true,
          "description": "%extension.contributes.configuration.properties.gerrit.commitInfo.defaultExpanded.description%"
        },
        "gerrit.relationChain.defaultExpanded": {
          "type": "boolean",
          "default": true,
          "description": "%extension.contributes.configuration.properties.gerrit.relationChain.defaultExpanded.description%"
        },
        "gerrit.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ],
          "default": "zh-CN",
          "enumDescriptions": [
            "%extension.contributes.configuration.properties.gerrit.language.enumDescriptions.0%",
            "English"
          ],
          "description": "%extension.contributes.configuration.properties.gerrit.language.description%"
        }
      }
    },
    "colors": [
      {
        "id": "gerrit.commentMarker",
        "description": "%extension.contributes.colors.0.description%",
        "defaults": {
          "dark": "#FFB020",
          "light": "#A15C00",
          "highContrast": "#FFFF00",
          "highContrastLight": "#8F4200"
        }
      }
    ],
    "keybindings": [
      {
        "command": "gerrit.comment",
        "key": "c",
        "when": "editorTextFocus && isInDiffEditor && resourceScheme == gerrit && editorReadonly"
      }
    ]
  },
  "icon": "media/icon.png",
  "keywords": [
    "gerrit",
    "code review",
    "diff",
    "comments",
    "ssh"
  ],
  "preview": true
}
